# CPU-only PyTorch Trainer. The serving path remains Go and receives a
# tensor-only JSON artifact, so this image is used exclusively by short-lived
# Kubernetes Jobs.
FROM python:3.13-slim-trixie AS build

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HOME=/tmp

COPY pytorch/requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir --upgrade pip==26.2.1
RUN python -m pip install --no-cache-dir --target /opt/replicasense-python -r /tmp/requirements.txt
COPY pytorch/gru_trainer.py /app/gru_trainer.py
RUN python -m py_compile /app/gru_trainer.py

# Keep only the interpreter, certificates, and installed runtime modules in the
# published image. Distroless Debian is maintained independently and has no
# package manager or shell available to an attacker.
FROM gcr.io/distroless/python3-debian13:nonroot
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/replicasense-python \
    HOME=/tmp
WORKDIR /app
COPY --from=build /opt/replicasense-python /opt/replicasense-python
COPY --from=build /app/gru_trainer.py /app/gru_trainer.py
USER nonroot:nonroot
ENTRYPOINT ["python", "/app/gru_trainer.py"]
